datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRoleType {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  BILLING_OFFICER
  LAB_TECHNICIAN
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SIGNED
}

enum CarePlanStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
  EXPIRED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_ANALYSIS
  COMPLETED
  CANCELLED
}

enum LabResultFlag {
  NORMAL
  HIGH
  LOW
  CRITICAL
}

enum DocumentVisibility {
  CLINICAL_ONLY
  STAFF_ONLY
  PATIENT_ACCESSIBLE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  INSURANCE_CLAIM
  BANK_TRANSFER
}

enum NotificationType {
  APPOINTMENT_REMINDER
  CAREPLAN_MILESTONE
  LAB_RESULT_READY
  INVOICE_ISSUED
  GENERAL_ALERT
}

// ==========================================
// CORE TENANCY & ORGANIZATIONS
// ==========================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  email       String
  phone       String
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String   @default("USA")
  website     String?
  logoUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations               ClinicLocation[]
  departments             Department[]
  users                   User[]
  patients                Patient[]
  appointments            Appointment[]
  clinicalEncounters      ClinicalEncounter[]
  carePlans               CarePlan[]
  prescriptions           Prescription[]
  labOrders               LabOrder[]
  medicalDocuments        MedicalDocument[]
  invoices                Invoice[]
  auditLogs               AuditLog[]
  medicationCatalogItems MedicationCatalogItem[]
  labTests                LabTest[]
}

model ClinicLocation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  phone          String
  email          String?
  address        String
  city           String
  state          String
  zipCode        String
  timeZone       String       @default("America/New_York")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments       Department[]
  providerSchedules ProviderSchedule[]
  appointments      Appointment[]

  @@unique([organizationId, code])
}

model Department {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       ClinicLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name           String
  code           String
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  providers ProviderProfile[]

  @@unique([organizationId, code])
}

// ==========================================
// IDENTITY, RBAC & USERS
// ==========================================

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  emailVerified  Boolean      @default(false)
  active         Boolean      @default(true)
  failedAttempts Int          @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userRoles               UserRole[]
  refreshSessions         RefreshSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  providerProfile         ProviderProfile?
  patient                 Patient?
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTasks            Task[]                   @relation("TaskCreator")
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@index([organizationId])
  @@index([email])
}

model Role {
  id          String       @id @default(uuid())
  name        UserRoleType @unique
  description String?
  createdAt   DateTime     @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. 'encounter:create'
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  deviceInfo   String?
  ipAddress    String?
  revoked      Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==========================================
// PROVIDERS & STAFF
// ==========================================

model ProviderProfile {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  npiNumber      String?
  licenseNumber  String
  specialty      String
  title          String      // Dr., MD, NP, etc.
  bio            String?
  consultFee     Decimal     @default(100.00) @db.Decimal(10, 2)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  schedules          ProviderSchedule[]
  timeOff            ProviderTimeOff[]
  appointments       Appointment[]
  clinicalEncounters ClinicalEncounter[]
  carePlans          CarePlan[]
  prescriptions      Prescription[]
  labOrders          LabOrder[]

  @@index([departmentId])
}

model ProviderSchedule {
  id         String         @id @default(uuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  locationId String
  location   ClinicLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek  Int            // 0=Sun, 1=Mon, ..., 6=Sat
  startTime  String         // HH:mm format, e.g. "09:00"
  endTime    String         // HH:mm format, e.g. "17:00"
  slotDurationMinutes Int   @default(30)
  bufferMinutes       Int   @default(5)
  active     Boolean        @default(true)

  @@index([providerId, dayOfWeek])
}

model ProviderTimeOff {
  id         String          @id @default(uuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  reason     String?
  approved   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  @@index([providerId, startDate, endDate])
}

// ==========================================
// PATIENTS & CLINICAL HISTORY
// ==========================================

model Patient {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  mrn            String       @unique // PAT-YYYYMMDD-XXXX
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         String
  bloodType      String?
  email          String
  phone          String
  address        String
  city           String
  state          String
  zipCode        String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contacts           PatientContact[]
  emergencyContacts  EmergencyContact[]
  insurancePolicies  InsurancePolicy[]
  allergies          Allergy[]
  conditions         MedicalCondition[]
  appointments       Appointment[]
  clinicalEncounters ClinicalEncounter[]
  carePlans          CarePlan[]
  prescriptions      Prescription[]
  labOrders          LabOrder[]
  medicalDocuments   MedicalDocument[]
  invoices           Invoice[]
  tasks              Task[]

  @@index([organizationId])
  @@index([mrn])
  @@index([lastName, firstName])
}

model PatientContact {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type       String   // Phone, Email, Address
  value      String
  isPrimary  Boolean  @default(false)
}

model EmergencyContact {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
}

model InsurancePolicy {
  id             String    @id @default(uuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerName   String
  policyNumber   String
  groupNumber    String?
  subscriberName String?
  relationship   String    @default("SELF")
  effectiveDate  DateTime
  expirationDate DateTime?
  active         Boolean   @default(true)
}

model Allergy {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen    String   // e.g. Penicillin, Peanuts
  category    String   @default("DRUG") // DRUG, FOOD, ENVIRONMENTAL
  severity    String   // MILD, MODERATE, SEVERE
  reaction    String?  // e.g. Anaphylaxis, Rash
  createdAt   DateTime @default(now())

  @@index([patientId, allergen])
}

model MedicalCondition {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  icdCode     String    // e.g. E11.9
  name        String    // e.g. Type 2 Diabetes Mellitus
  onsetDate   DateTime?
  status      String    @default("ACTIVE") // ACTIVE, RESOLVED, CHRONIC
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
}

// ==========================================
// APPOINTMENTS
// ==========================================

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       ClinicLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  providerId     String
  provider       ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startTime      DateTime
  endTime        DateTime
  type           String            // Consultation, Follow-up, Vaccination
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  cancellationReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  statusEvents       AppointmentStatusEvent[]
  clinicalEncounters ClinicalEncounter[]

  @@index([organizationId])
  @@index([providerId, startTime, endTime])
  @@index([patientId])
}

model AppointmentStatusEvent {
  id            String            @id @default(uuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus    AppointmentStatus
  toStatus      AppointmentStatus
  note          String?
  changedByUserId String?
  createdAt     DateTime          @default(now())
}

// ==========================================
// CLINICAL ENCOUNTERS & CARE PLANS
// ==========================================

model ClinicalEncounter {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId     String
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  encounterDate  DateTime        @default(now())
  status         EncounterStatus @default(DRAFT)
  chiefComplaint String
  symptoms       String?
  assessment     String?
  plan           String?
  signedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  vitals          VitalReading[]
  diagnoses       Diagnosis[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  medicalDocuments MedicalDocument[]

  @@index([organizationId])
  @@index([patientId])
  @@index([providerId])
}

model VitalReading {
  id          String            @id @default(uuid())
  encounterId String
  encounter   ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  heightCm    Decimal?          @db.Decimal(5, 2)
  weightKg    Decimal?          @db.Decimal(5, 2)
  systolicBp  Int?
  diastolicBp Int?
  heartRate   Int?
  tempCelsius Decimal?          @db.Decimal(4, 2)
  spo2Percent Int?
  bmi         Decimal?          @db.Decimal(4, 2)
  recordedAt  DateTime          @default(now())
}

model Diagnosis {
  id          String            @id @default(uuid())
  encounterId String
  encounter   ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icdCode     String
  description String
  type        String            @default("PRIMARY") // PRIMARY, SECONDARY
  createdAt   DateTime          @default(now())
}

model CarePlan {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId     String
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  condition      String
  status         CarePlanStatus  @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime?
  progress       Int             @default(0) // 0-100%
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  goals            CarePlanGoal[]
  milestones       CarePlanMilestone[]
  progressEntries CarePlanProgressEntry[]
  tasks            Task[]

  @@index([organizationId])
  @@index([patientId])
}

model CarePlanGoal {
  id         String   @id @default(uuid())
  carePlanId String
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  description String
  targetDate  DateTime?
  completed   Boolean  @default(false)
}

model CarePlanMilestone {
  id         String   @id @default(uuid())
  carePlanId String
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime
  completed  Boolean  @default(false)
  completedAt DateTime?
}

model CarePlanProgressEntry {
  id          String   @id @default(uuid())
  carePlanId  String
  carePlan    CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  updatedBy   String   // Patient or Staff Name
  notes       String
  percentage  Int
  createdAt   DateTime @default(now())
}

model Task {
  id           String        @id @default(uuid())
  patientId    String?
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  carePlanId   String?
  carePlan     CarePlan?     @relation(fields: [carePlanId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId    String?
  creator      User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  dueDate      DateTime
  priority     TaskPriority  @default(MEDIUM)
  status       TaskStatus    @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([patientId])
  @@index([assigneeId])
}

// ==========================================
// PRESCRIPTIONS & PHARMACY
// ==========================================

model MedicationCatalogItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // e.g. Amoxicillin
  code           String?      // RxNorm or NDC code
  form           String       // Tablet, Capsule, Liquid
  strength       String       // 500mg, 10mg/ml
  active         Boolean      @default(true)

  prescriptionItems PrescriptionItem[]

  @@unique([organizationId, name, strength])
}

model Prescription {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId     String
  provider       ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  encounterId    String?
  encounter      ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  status         PrescriptionStatus @default(ACTIVE)
  startDate      DateTime           @default(now())
  endDate        DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items PrescriptionItem[]

  @@index([organizationId])
  @@index([patientId])
}

model PrescriptionItem {
  id             String                 @id @default(uuid())
  prescriptionId String
  prescription   Prescription           @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId   String?
  medication     MedicationCatalogItem? @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  medicationName String
  dosage         String                 // 1 tablet
  frequency      String                 // Twice daily
  route          String                 // Oral
  refills        Int                    @default(0)
  instructions   String
}

// ==========================================
// LABORATORY WORKFLOWS
// ==========================================

model LabTest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       // LOINC or internal code
  name           String       // e.g. Complete Blood Count (CBC)
  category       String       // Hematology, Biochemistry
  specimenType   String       // Whole Blood, Serum, Urine
  referenceRange String?      // e.g. 4.5-11.0 x10^3/uL
  unit           String?      // e.g. mg/dL
  active         Boolean      @default(true)

  orderItems LabOrderItem[]

  @@unique([organizationId, code])
}

model LabOrder {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId     String
  provider       ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  encounterId    String?
  encounter      ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  status         LabOrderStatus     @default(ORDERED)
  clinicalNotes  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items LabOrderItem[]

  @@index([organizationId])
  @@index([patientId])
}

model LabOrderItem {
  id         String   @id @default(uuid())
  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTestId  String
  labTest    LabTest  @relation(fields: [labTestId], references: [id], onDelete: Cascade)

  result LabResult?
}

model LabResult {
  id             String        @id @default(uuid())
  labOrderItemId String        @unique
  labOrderItem   LabOrderItem  @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)
  resultValue    String
  unit           String?
  referenceRange String?
  flag           LabResultFlag @default(NORMAL)
  performedBy    String        // Technician name
  resultDate     DateTime      @default(now())
  notes          String?
  reviewedByDoctor Boolean     @default(false)

  @@index([flag])
}

// ==========================================
// MEDICAL DOCUMENTS
// ==========================================

model MedicalDocument {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId    String?
  encounter      ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String             @unique
  category       String             // Lab Summary, Imaging, Referral, Clinical Note
  visibility     DocumentVisibility @default(CLINICAL_ONLY)
  uploadedBy     String
  createdAt      DateTime           @default(now())

  @@index([organizationId])
  @@index([patientId])
}

// ==========================================
// BILLING & FINANCIAL LEDGER
// ==========================================

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber  String        @unique // INV-YYYYMMDD-XXXX
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status         InvoiceStatus @default(ISSUED)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0.00) @db.Decimal(12, 2)
  discount       Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  refunds  Refund[]

  @@index([organizationId])
  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CREDIT_CARD)
  transactionRef String?
  paymentDate   DateTime      @default(now())
  notes         String?

  refunds Refund[]

  @@index([invoiceId])
}

model Refund {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  refundDate  DateTime @default(now())

  @@index([invoiceId])
}

// ==========================================
// NOTIFICATIONS & AUDIT LOGS
// ==========================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(GENERAL_ALERT)
  read      Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model NotificationPreference {
  id             String  @id @default(uuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlerts    Boolean @default(true)
  inAppAlerts    Boolean @default(true)
  appointmentReminders Boolean @default(true)
  carePlanUpdates Boolean @default(true)

  @@unique([userId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail      String?
  action         String       // e.g. VIEW_PATIENT_RECORD, CREATE_PRESCRIPTION
  resourceType   String       // e.g. Patient, Prescription, Invoice
  resourceId     String
  ipAddress      String?
  userAgent      String?
  changeSummary  String?
  timestamp      DateTime     @default(now())

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([timestamp])
}
