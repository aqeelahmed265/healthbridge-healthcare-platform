{
  "name": "healthbridge",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "node apps/api/node_modules/prisma/build/index.js generate --schema=prisma/schema.prisma",
    "db:migrate": "node apps/api/node_modules/prisma/build/index.js migrate dev --schema=prisma/schema.prisma",
    "db:seed": "node apps/api/node_modules/ts-node/dist/bin.js apps/api/src/seed.ts",
    "db:reset": "node apps/api/node_modules/prisma/build/index.js migrate reset --force --schema=prisma/schema.prisma",
    "db:studio": "node apps/api/node_modules/prisma/build/index.js studio --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^5.12.1",
    "@types/node": "^20.11.24",
    "argon2": "^0.40.1",
    "decimal.js": "^10.4.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prisma": "^5.12.1",
    "ts-node": "^10.9.2",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
