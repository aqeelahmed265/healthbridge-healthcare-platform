{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./apps/api/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./apps/api/node_modules/@prisma/client"],
      "argon2": ["./apps/api/node_modules/argon2"],
      "@healthbridge/shared": ["./packages/shared/src/index.ts"],
      "@healthbridge/contracts": ["./packages/contracts/src/index.ts"]
    }
  },
  "include": ["prisma/**/*"]
}
