# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthbridge?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# API Configuration
PORT=4000
NODE_ENV="development"
API_PREFIX="api/v1"
CORS_ORIGIN="http://localhost:3000"

# Security & JWT Tokens
JWT_ACCESS_SECRET="healthbridge-dev-access-secret-32bytes-min!!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="healthbridge-dev-refresh-secret-32bytes-min!!"
JWT_REFRESH_EXPIRATION="7d"

# MinIO / Object Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="healthbridge-documents"

# Web App Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
